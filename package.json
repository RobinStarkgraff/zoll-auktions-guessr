{
  "name": "guess-the-price",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch server/src/index.ts\" \"vite\"",
    "dev:mock": "ITEM_SOURCE=mock npm run dev",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/src/index.ts",
    "test": "vitest run --root .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
